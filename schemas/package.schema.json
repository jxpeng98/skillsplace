{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillsplace.local/schemas/package.schema.json",
  "title": "Skillsplace Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "slug",
    "version",
    "description",
    "license",
    "publisher",
    "categories",
    "keywords",
    "platforms",
    "security"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      }
    },
    "platforms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "manifest"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "plugin",
              "skill",
              "adapter"
            ]
          },
          "path": {
            "type": "string"
          },
          "manifest": {
            "type": "string"
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "secrets",
        "dataAccess"
      ],
      "properties": {
        "network": {
          "type": "string"
        },
        "secrets": {
          "type": "string"
        },
        "dataAccess": {
          "type": "string"
        }
      }
    }
  }
}
