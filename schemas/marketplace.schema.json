{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillsplace.local/schemas/marketplace.schema.json",
  "title": "Skillsplace Marketplace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "displayName",
    "version",
    "description",
    "packages"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "slug",
          "version",
          "description",
          "manifest",
          "platforms"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "manifest": {
            "type": "string",
            "pattern": "^\\./"
          },
          "platforms": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "path"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "plugin",
                    "skill",
                    "adapter"
                  ]
                },
                "path": {
                  "type": "string",
                  "pattern": "^\\./"
                },
                "marketplace": {
                  "type": "string",
                  "pattern": "^\\./"
                }
              }
            }
          }
        }
      }
    }
  }
}
